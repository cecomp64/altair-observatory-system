<%# Primary links stay visible on wide screens; the rest sit under "More".
    Below lg everything moves into the hamburger panel. %>
<% primary = [
     [ "Dashboard", root_path, %w[dashboard] ],
     [ "Observatory", observatory_path, %w[observatory] ],
     [ "Projects", projects_path, %w[projects project_wizard project_processing] ],
     [ "Catalogue", objects_path, %w[objects showcases] ],
     [ "Files", frames_path, %w[frames] ]
   ]
   more = [
     [ "Targets", targets_path, %w[targets target_plans] ],
     [ "Telescopes", telescopes_path, %w[telescopes optical_trains] ],
     [ "Issues", issues_path, %w[issues] ]
   ]
   more << [ "Admin", admin_root_path, [] ] if current_user.admin?
   active = ->(controllers) { controllers.include?(controller_name) && !controller_path.start_with?("admin/") || (controllers.empty? && controller_path.start_with?("admin/")) }
   link = "rounded-md px-3 py-2 hover:bg-slate-800 hover:text-white"
   current = "bg-slate-800 text-white" %>

<nav class="relative bg-slate-900 text-slate-100" aria-label="Main">
  <div class="mx-auto max-w-5xl px-4 py-2 flex items-center justify-between gap-4">
    <%= link_to "Remote Observatory", root_path, class: "font-semibold tracking-tight whitespace-nowrap" %>

    <div class="hidden lg:flex flex-1 items-center gap-1 text-sm text-slate-300">
      <% primary.each do |label, path, controllers| %>
        <%= link_to label, path, class: "#{link} #{current if active.(controllers)}", aria: { current: (active.(controllers) ? "page" : nil) } %>
      <% end %>
      <details class="relative" data-controller="dropdown">
        <summary class="<%= link %> <%= current if more.any? { |_, _, c| active.(c) } %> list-none cursor-pointer select-none">More ▾</summary>
        <div class="absolute left-0 z-20 mt-1 w-44 rounded-lg bg-white py-1 text-slate-700 shadow-lg ring-1 ring-slate-200">
          <% more.each do |label, path, controllers| %>
            <%= link_to label, path, class: "block px-4 py-2 hover:bg-slate-50 #{'font-medium text-indigo-700' if active.(controllers)}" %>
          <% end %>
        </div>
      </details>
    </div>

    <div class="hidden lg:flex items-center gap-2 text-sm text-slate-300">
      <%= link_to "New project", new_project_path(new: 1), class: "rounded-md bg-indigo-600 px-3 py-1.5 font-medium text-white hover:bg-indigo-500 whitespace-nowrap" %>
      <details class="relative" data-controller="dropdown">
        <summary class="<%= link %> list-none cursor-pointer select-none max-w-40 truncate"><%= current_user.display_name %> ▾</summary>
        <div class="absolute right-0 z-20 mt-1 w-44 rounded-lg bg-white py-1 text-slate-700 shadow-lg ring-1 ring-slate-200">
          <%= link_to "Profile", edit_profile_path, class: "block px-4 py-2 hover:bg-slate-50" %>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "block w-full text-left px-4 py-2 hover:bg-slate-50 cursor-pointer" %>
        </div>
      </details>
    </div>

    <details class="lg:hidden" data-controller="dropdown">
      <summary class="list-none cursor-pointer rounded-md p-2 hover:bg-slate-800" aria-label="Menu">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-12 z-20 border-t border-slate-800 bg-slate-900 px-4 pb-4 pt-2 text-slate-200 shadow-lg">
        <div class="flex flex-col">
          <% (primary + more).each do |label, path, controllers| %>
            <%= link_to label, path, class: "#{link} #{current if active.(controllers)}", aria: { current: (active.(controllers) ? "page" : nil) } %>
          <% end %>
          <%= link_to "New project", new_project_path(new: 1), class: "mt-2 rounded-md bg-indigo-600 px-3 py-2 text-center font-medium text-white hover:bg-indigo-500" %>
          <div class="mt-3 border-t border-slate-800 pt-3 flex items-center justify-between text-sm">
            <%= link_to current_user.display_name, edit_profile_path, class: "hover:text-white" %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "underline hover:text-white bg-transparent border-0 p-0 cursor-pointer" %>
          </div>
        </div>
      </div>
    </details>
  </div>
</nav>
