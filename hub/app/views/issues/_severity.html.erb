<% colors = { "blocking" => "bg-rose-100 text-rose-700", "warning" => "bg-amber-100 text-amber-700", "info" => "bg-slate-100 text-slate-600" } %>
<span class="rounded-full px-2 py-0.5 text-xs font-medium <%= colors[issue.severity] %>"><%= issue.severity %></span>
<% unless issue.open? %><span class="rounded-full px-2 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-700"><%= issue.status %></span><% end %>
