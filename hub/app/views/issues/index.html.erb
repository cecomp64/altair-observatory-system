<% content_for :title, "Processing issues" %>
<h1 class="text-2xl font-semibold">Processing issues</h1>
<div class="flex gap-3 text-sm mt-1 mb-4">
  <% %w[open resolved waived all].each do |s| %>
    <%= link_to s.humanize, issues_path(status: s), class: @status == s ? "font-medium text-slate-900" : "text-slate-500 hover:text-slate-700" %>
  <% end %>
</div>
<div class="rounded-xl border border-slate-200 bg-white p-5">
  <% if @issues.any? %><%= render "issues/list", issues: @issues %><% else %><p class="text-sm text-slate-400">No <%= @status unless @status == "all" %> issues.</p><% end %>
</div>
<%= render "shared/pagination", pagy: @pagy %>
