<% content_for :title, @issue.kind %>

<%= link_to "← Issues", issues_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
<div class="mt-3 flex items-center gap-2"><h1 class="text-xl font-semibold font-mono"><%= @issue.kind %></h1><%= render "issues/severity", issue: @issue %></div>
<p class="text-slate-700 mt-2"><%= @issue.message %></p>
<p class="text-sm text-slate-500 mt-1">
  <%= safe_join([ (@issue.project && link_to(@issue.project.name, project_path(@issue.project), class: "text-indigo-600 hover:underline")),
                  (@issue.target && link_to(@issue.target.name, target_path(@issue.target), class: "text-indigo-600 hover:underline")),
                  @issue.optical_train&.name, @issue.night, @issue.filter, "node #{@issue.processing_node.name}" ].compact, " · ") %>
</p>
<p class="text-xs text-slate-400">Opened <%= l(@issue.opened_at, format: :long) %><%= " · #{@issue.status} #{l(@issue.resolved_at, format: :long)}" if @issue.resolved_at %><%= " · #{@issue.resolution}" if @issue.resolution.present? %></p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">What resolves it</h2>
    <% if @issue.requirement.present? %>
      <pre class="text-xs bg-slate-50 rounded-lg p-3 overflow-x-auto"><%= JSON.pretty_generate(@issue.requirement) %></pre>
    <% else %>
      <p class="text-sm text-slate-400">Altair didn't give a requirement.</p>
    <% end %>
    <% if @issue.scope.present? %>
      <p class="text-xs text-slate-400 mt-3">Scope: <%= @issue.scope.map { |k, v| "#{k} #{v}" }.join(" · ") %></p>
    <% end %>
  </div>
  <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-4">
    <h2 class="text-sm font-medium text-slate-500">Actions</h2>
    <% if policy(@issue).waive? %>
      <%= form_with url: waive_issue_path(@issue), method: :post, class: "space-y-2" do %>
        <textarea name="note" rows="2" placeholder="Why can this be waived?" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
        <%= submit_tag "Waive", class: "rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-medium text-white cursor-pointer" %>
      <% end %>
    <% end %>
    <% if policy(@issue).approve? && @issue.fetch_approval? %>
      <div class="flex gap-2">
        <%= button_to "Approve fetch", approve_issue_path(@issue), class: "rounded-lg bg-indigo-600 px-3 py-1.5 text-sm font-medium text-white cursor-pointer" %>
        <%= button_to "Deny", deny_issue_path(@issue), class: "rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium cursor-pointer" %>
      </div>
    <% end %>
    <% unless @issue.open? %><p class="text-sm text-slate-400">Nothing to do: the issue is <%= @issue.status %>.</p><% end %>
    <% if @commands.any? %>
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-400 mb-1">Commands</p>
        <%= render "processing_commands/list", commands: @commands %>
      </div>
    <% end %>
  </div>
</div>
