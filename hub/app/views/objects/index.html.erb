<% content_for :title, "Catalogue" %>
<% field = "rounded-lg border border-slate-300 px-2 py-1.5 text-sm" %>

<div class="flex items-center justify-between mb-4">
  <div>
    <h1 class="text-2xl font-semibold">Catalogue</h1>
    <p class="text-slate-500 text-sm">OpenNGC, LDN, LBN, AAVSO campaign targets and objects members have added. Search any name or alias.</p>
  </div>
  <% if policy(AstroObject).create? %>
    <%= link_to "Add an object", new_object_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-100" %>
  <% end %>
</div>

<% if @lists.any? %>
  <div class="flex flex-wrap items-center gap-2 mb-3 text-sm">
    <span class="text-slate-500">Featured now:</span>
    <% @lists.each do |list| %>
      <% current = params[:list] == list.key %>
      <%= link_to request.query_parameters.merge("list" => (current ? nil : list.key), "page" => nil).compact_blank,
            class: "rounded-full border px-3 py-1 #{current ? 'border-indigo-600 bg-indigo-600 text-white' : 'border-slate-300 text-slate-700 hover:bg-slate-100'}",
            title: list.source::DESCRIPTION do %>
        <%= list.name %> <span class="<%= current ? 'text-indigo-100' : 'text-slate-400' %>"><%= @list_counts[list.id].to_i %></span>
      <% end %>
    <% end %>
  </div>
<% end %>

<%= form_with url: objects_path, method: :get, class: "rounded-xl border border-slate-200 bg-white p-4 grid grid-cols-2 md:grid-cols-6 gap-3 items-end", data: { turbo_frame: "_top" } do %>
  <%= hidden_field_tag :list, params[:list] if params[:list].present? %>
  <div class="col-span-2">
    <label class="block text-xs text-slate-500 mb-1">Search</label>
    <input type="search" name="q" value="<%= params[:q] %>" placeholder="M 31, Pelican, NGC 7000…" class="w-full <%= field %>">
  </div>
  <div>
    <label class="block text-xs text-slate-500 mb-1">Type</label>
    <%= select_tag :type, options_for_select(@facets[:types], params[:type]), include_blank: "Any", class: "w-full #{field}" %>
  </div>
  <div>
    <label class="block text-xs text-slate-500 mb-1">Constellation</label>
    <%= select_tag :constellation, options_for_select(@facets[:constellations], params[:constellation]), include_blank: "Any", class: "w-full #{field}" %>
  </div>
  <div>
    <label class="block text-xs text-slate-500 mb-1">Catalogue</label>
    <%= select_tag :catalog, options_for_select(@facets[:catalogs], params[:catalog]), include_blank: "Any", class: "w-full #{field}" %>
  </div>
  <div class="grid grid-cols-2 gap-2">
    <div>
      <label class="block text-xs text-slate-500 mb-1">Mag ≤</label>
      <input type="number" step="0.5" name="mag_max" value="<%= params[:mag_max] %>" class="w-full <%= field %>">
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-1">Size ≥ ′</label>
      <input type="number" step="1" name="size_min" value="<%= params[:size_min] %>" class="w-full <%= field %>">
    </div>
  </div>
  <div class="col-span-2 md:col-span-3 flex items-center gap-2">
    <%= select_tag :telescope, options_for_select(@telescopes.map { |t| [ t.name, t.slug ] }, @telescope&.slug), class: field %>
    <label class="flex items-center gap-2 text-sm text-slate-700">
      <%= check_box_tag :tonight, "1", params[:tonight] == "1", class: "h-4 w-4" %> Well placed tonight
    </label>
  </div>
  <div class="col-span-2 md:col-span-2">
    <%= select_tag :sort, options_for_select([ [ "Best match / name", "" ], [ "Brightest", "magnitude" ], [ "Largest", "size" ], [ "Best tonight", "score" ] ], params[:sort]), class: "w-full #{field}" %>
  </div>
  <div class="flex justify-end">
    <%= submit_tag "Apply", name: nil, class: "rounded-lg bg-indigo-600 px-4 py-1.5 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>

<div class="rounded-xl border border-slate-200 bg-white mt-4 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-slate-400 border-b border-slate-100">
      <tr>
        <th class="px-4 py-2">Object</th><th class="px-2 py-2">Type</th><th class="px-2 py-2">Const.</th>
        <th class="px-2 py-2">Mag</th><th class="px-2 py-2">Size</th>
        <% if @telescope %><th class="px-2 py-2">Tonight at <%= @telescope.name %></th><% end %>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @objects.each do |object| %>
        <tr class="group cursor-pointer hover:bg-indigo-50 focus-within:bg-indigo-50" data-object-row="<%= object.id %>"
            data-controller="row-link" data-action="click->row-link#open auxclick->row-link#open">
          <td class="px-4 py-2">
            <%= link_to object.primary_name, object_path(object, telescope: @telescope&.slug),
                  class: "font-medium group-hover:text-indigo-600 focus:outline-none", data: { row_link_target: "link" } %>
            <% Array(@listings[object.id]).each do |entry| %>
              <span class="ml-1 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800" title="On <%= entry.dynamic_catalogue.name %> since <%= l(entry.first_seen_at.to_date, format: :long) %>"><%= entry.dynamic_catalogue.short_name %></span>
            <% end %>
            <p class="text-xs text-slate-400"><%= object.aliases.map(&:name).reject { |n| n == object.primary_name }.first(4).join(", ") %></p>
          </td>
          <td class="px-2 py-2 text-slate-600"><%= object.object_type %></td>
          <td class="px-2 py-2 text-slate-600"><%= object.constellation %></td>
          <td class="px-2 py-2 text-slate-600"><%= object.magnitude&.to_f %></td>
          <td class="px-2 py-2 text-slate-600"><%= object.size_major_arcmin && "#{object.size_major_arcmin.to_f.round(1)}′" %></td>
          <% if @telescope %>
            <td class="px-2 py-2">
              <% if object.coordinates? %>
                <% result = @visibility.for_night(object.ra_deg, object.dec_deg, @night.date) %>
                <div class="flex items-center gap-2">
                  <%= altitude_sparkline(result, @night) %>
                  <span class="text-xs text-slate-500"><%= result.hours_clear_in_darkness.round(1) %> h</span>
                </div>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @objects.empty? %>
    <p class="px-4 py-6 text-sm text-slate-400">No objects match.
      <% if AstroObject.none? %>The catalogue is empty — an admin can import it under Admin → Catalogue.<% end %></p>
  <% end %>
</div>
<%= render "shared/pagination", pagy: @pagy %>
