<% content_for :title, "Catalogue" %>

<div class="flex items-center justify-between mb-4">
  <div>
    <h1 class="text-2xl font-semibold">Catalogue</h1>
    <p class="text-slate-500 text-sm">OpenNGC, LDN, LBN and objects members have added. Search any name or alias.</p>
  </div>
  <% if policy(AstroObject).create? %>
    <%= link_to "Add an object", new_object_path, class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-100" %>
  <% end %>
</div>

<%
  chip = "inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden transition-colors"
  chip_off = "border-slate-300 bg-white text-slate-700 hover:border-slate-400 hover:bg-slate-50"
  chip_on = "border-indigo-300 bg-indigo-50 text-indigo-700 hover:bg-indigo-100"
  panel = "absolute left-0 z-20 mt-2 w-64 rounded-xl border border-slate-200 bg-white p-3 shadow-lg"
  active = active_object_filters
  lists = { type: [ "Type", @facets[:types] ], constellation: [ "Constellation", @facets[:constellations] ], catalog: [ "Catalogue", @facets[:catalogs] ] }
%>
<%= form_with url: objects_path, method: :get, data: { turbo_frame: "_top", controller: "filters", action: "change->filters#submit" }, class: "space-y-3" do %>
  <%= hidden_field_tag :telescope, "none" if @telescopes.empty? %>
  <div class="flex flex-wrap items-center gap-2">
    <div class="relative flex-1 min-w-[16rem]">
      <svg class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"/><path d="m14 14 4 4" stroke-linecap="round"/></svg>
      <input type="search" name="q" value="<%= params[:q] %>" placeholder="Search any name or alias: M 31, Pelican, NGC 7000…" autocomplete="off"
             class="w-full rounded-full border border-slate-300 bg-white py-2.5 pl-10 pr-4 text-sm shadow-sm focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-200">
    </div>
    <% if @telescopes.any? %>
      <label class="flex items-center gap-2 text-sm text-slate-500">
        <span class="hidden sm:inline">Visibility at</span>
        <%= select_tag :telescope, options_for_select(@telescopes.map { |t| [ t.name, t.slug ] }, @telescope&.slug), class: "rounded-full border border-slate-300 bg-white py-2 pl-3 pr-8 text-sm text-slate-700" %>
      </label>
    <% end %>
    <label class="flex items-center gap-2 text-sm text-slate-500">
      <span class="hidden sm:inline">Sort</span>
      <%= select_tag :sort, options_for_select([ [ "Best match / name", "" ], [ "Brightest", "magnitude" ], [ "Largest", "size" ], [ "Best tonight", "score" ] ], params[:sort]), class: "rounded-full border border-slate-300 bg-white py-2 pl-3 pr-8 text-sm text-slate-700" %>
    </label>
  </div>

  <div class="flex flex-wrap items-center gap-2">
    <% lists.each do |key, (label, options)| %>
      <% selected = list_param(key) %>
      <details class="relative" data-controller="dropdown">
        <summary class="<%= chip %> <%= selected.any? ? chip_on : chip_off %>">
          <%= label %>
          <% if selected.any? %><span class="rounded-full bg-indigo-600 px-1.5 text-xs font-medium text-white"><%= selected.size %></span><% end %>
          <svg class="h-3.5 w-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m5 8 5 5 5-5z"/></svg>
        </summary>
        <div class="<%= panel %>" data-filter-list>
          <% if options.size > 8 %>
            <input type="search" placeholder="Find <%= label.downcase %>…" data-action="input->filters#narrow change->filters#stop" autocomplete="off"
                   class="mb-2 w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm">
          <% end %>
          <div class="max-h-60 space-y-0.5 overflow-y-auto">
            <% (selected | options).each do |option| %>
              <label data-option="<%= option %>" class="flex cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 text-sm text-slate-700 hover:bg-slate-100">
                <%= check_box_tag "#{key}[]", option, selected.include?(option), id: nil, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
                <%= option %>
              </label>
            <% end %>
            <% if options.empty? %><p class="px-2 py-1.5 text-sm text-slate-400">Nothing to filter by yet.</p><% end %>
          </div>
        </div>
      </details>
    <% end %>

    <details class="relative" data-controller="dropdown">
      <% range_active = params[:mag_max].present? || params[:size_min].present? %>
      <summary class="<%= chip %> <%= range_active ? chip_on : chip_off %>">
        Brightness &amp; size
        <svg class="h-3.5 w-3.5 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="m5 8 5 5 5-5z"/></svg>
      </summary>
      <div class="<%= panel %> space-y-3">
        <label class="block text-xs font-medium text-slate-500">Brighter than (magnitude)
          <input type="number" step="0.5" name="mag_max" value="<%= params[:mag_max] %>" placeholder="e.g. 9" class="mt-1 w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm font-normal text-slate-800">
        </label>
        <label class="block text-xs font-medium text-slate-500">Larger than (arcminutes)
          <input type="number" step="1" name="size_min" value="<%= params[:size_min] %>" placeholder="e.g. 30" class="mt-1 w-full rounded-lg border border-slate-300 px-2.5 py-1.5 text-sm font-normal text-slate-800">
        </label>
      </div>
    </details>

    <% if @telescopes.any? %>
      <label class="<%= chip %> <%= params[:tonight] == "1" ? chip_on : chip_off %>">
        <%= check_box_tag :tonight, "1", params[:tonight] == "1", class: "sr-only" %>
        <span aria-hidden="true">☾</span> Well placed tonight
      </label>
    <% end %>
    <noscript><%= submit_tag "Apply", name: nil, class: "rounded-full bg-indigo-600 px-4 py-1.5 text-sm text-white" %></noscript>
  </div>
<% end %>

<div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
  <span class="text-slate-500" data-result-count><%= number_with_delimiter(@total) %> <%= "object".pluralize(@total) %></span>
  <% active.each do |filter| %>
    <%= link_to filter[:url], class: "group inline-flex items-center gap-1.5 rounded-full bg-slate-100 py-1 pl-3 pr-2 text-slate-700 hover:bg-slate-200", title: "Remove filter" do %>
      <%= filter[:label] %><span class="text-slate-400 group-hover:text-slate-700" aria-hidden="true">×</span><span class="sr-only">Remove <%= filter[:label] %></span>
    <% end %>
  <% end %>
  <% if active.any? || params[:q].present? %>
    <%= link_to "Clear all", objects_path(telescope: params[:telescope].presence), class: "text-indigo-600 hover:underline ml-1" %>
  <% end %>
</div>

<div class="rounded-xl border border-slate-200 bg-white mt-3 overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="text-left text-slate-400 border-b border-slate-100">
      <tr>
        <th class="px-4 py-2">Object</th><th class="px-2 py-2">Type</th><th class="px-2 py-2">Const.</th>
        <th class="px-2 py-2">Mag</th><th class="px-2 py-2">Size</th>
        <% if @telescope %><th class="px-2 py-2">Tonight at <%= @telescope.name %></th><% end %>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @objects.each do |object| %>
        <tr class="group cursor-pointer hover:bg-indigo-50 focus-within:bg-indigo-50" data-object-row="<%= object.id %>"
            data-controller="row-link" data-action="click->row-link#open auxclick->row-link#open">
          <td class="px-4 py-2">
            <%= link_to object.primary_name, object_path(object, telescope: @telescope&.slug),
                  class: "font-medium group-hover:text-indigo-600 focus:outline-none", data: { row_link_target: "link" } %>
            <p class="text-xs text-slate-400"><%= object.aliases.map(&:name).reject { |n| n == object.primary_name }.first(4).join(", ") %></p>
          </td>
          <td class="px-2 py-2 text-slate-600"><%= object.object_type %></td>
          <td class="px-2 py-2 text-slate-600"><%= object.constellation %></td>
          <td class="px-2 py-2 text-slate-600"><%= object.magnitude&.to_f %></td>
          <td class="px-2 py-2 text-slate-600"><%= object.size_major_arcmin && "#{object.size_major_arcmin.to_f.round(1)}′" %></td>
          <% if @telescope %>
            <td class="px-2 py-2">
              <% if object.coordinates? %>
                <% result = @visibility.for_night(object.ra_deg, object.dec_deg, @night.date) %>
                <div class="flex items-center gap-2">
                  <%= altitude_sparkline(result, @night) %>
                  <span class="text-xs text-slate-500"><%= result.hours_clear_in_darkness.round(1) %> h</span>
                </div>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @objects.empty? %>
    <p class="px-4 py-6 text-sm text-slate-400">No objects match.
      <% if AstroObject.none? %>The catalogue is empty — an admin can import it under Admin → Catalogue.<% end %></p>
  <% end %>
</div>
<%= render "shared/pagination", pagy: @pagy %>
