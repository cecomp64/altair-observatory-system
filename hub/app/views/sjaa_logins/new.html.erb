<% content_for :title, "Log in with SJAA" %>

<div class="max-w-sm mx-auto mt-12 rounded-xl border border-slate-200 bg-white p-6">
  <% if user_signed_in? %>
    <h2 class="text-xl font-semibold mb-1">Link your SJAA membership</h2>
    <p class="text-slate-500 text-sm mb-6">Enter the email address on your SJAA membership. We'll email it a link that connects the membership to this account.</p>
  <% else %>
    <h2 class="text-xl font-semibold mb-1">Log in with SJAA</h2>
    <p class="text-slate-500 text-sm mb-6">Enter the email address on your SJAA membership. We'll email it a link to log in; your first login creates your account here.</p>
  <% end %>

  <%= form_with url: sjaa_login_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :email, "SJAA email address", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.email_field :email, value: current_user&.email, required: true, autofocus: true, autocomplete: "email",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <%= f.submit "Email me a link", class: "w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% end %>

  <p class="mt-4 text-xs text-slate-400">
    Not a member, or not sure which address SJAA has?
    <%= link_to "Visit the SJAA membership site", sjaa_membership_url, target: "_blank", rel: "noopener", class: "text-indigo-600 hover:underline" %>.
  </p>
  <% unless user_signed_in? %>
    <p class="mt-2 text-sm text-slate-500"><%= link_to "Log in with a password instead", new_user_session_path, class: "text-indigo-600 hover:underline" %></p>
  <% end %>
</div>
