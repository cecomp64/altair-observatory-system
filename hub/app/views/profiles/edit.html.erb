<% content_for :title, "Profile" %>

<h1 class="text-2xl font-semibold mb-6">Your profile</h1>

<div class="max-w-lg space-y-8">
  <%= form_with model: @user, url: profile_path, method: :patch, class: "rounded-xl border border-slate-200 bg-white p-5 space-y-5" do |f| %>
    <div>
      <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div>
      <%= f.label :discord_webhook_url, "Discord webhook URL", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <p class="text-xs text-slate-400 mb-1">Optional — used to send you progress alerts in Discord.</p>
      <%= f.text_field :discord_webhook_url, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>

    <div class="flex items-center gap-6">
      <label class="flex items-center gap-2 text-sm">
        <%= f.check_box :notify_email, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %> Email me progress updates
      </label>
      <label class="flex items-center gap-2 text-sm">
        <%= f.check_box :notify_discord, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %> Discord me progress updates
      </label>
    </div>

    <%= f.submit "Save", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% end %>

  <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-3">
    <h2 class="text-sm font-medium text-slate-500">SJAA membership</h2>
    <%= form_with model: @user, url: profile_path, method: :patch, class: "space-y-3" do |f| %>
      <div>
        <%= f.label :sjaa_membership_number, "SJAA membership number", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field :sjaa_membership_number, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%= f.submit "Save", class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-100 cursor-pointer" %>
    <% end %>
    <p class="text-xs text-slate-400">
      Need to check or renew your membership?
      <%= link_to "Visit the SJAA membership site", sjaa_membership_url, target: "_blank", rel: "noopener", class: "text-indigo-600 hover:underline" %>.
    </p>
  </div>
</div>
