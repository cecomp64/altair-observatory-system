<% content_for :title, "Edit #{@project.name}" %>
<% field = "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
<% label = "block text-sm font-medium text-slate-700 mb-1" %>

<%= link_to "← #{@project.name}", project_path(@project), class: "text-sm text-slate-500 hover:text-slate-700" %>
<h1 class="text-2xl font-semibold mt-3 mb-6">Edit project</h1>

<%= form_with model: @project, class: "max-w-xl space-y-5" do |f| %>
  <% if @project.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3 text-sm text-rose-700"><%= @project.errors.full_messages.to_sentence %></div>
  <% end %>
  <div><%= f.label :name, class: label %><%= f.text_field :name, class: field %></div>
  <div><%= f.label :description, class: label %><%= f.text_area :description, rows: 3, class: field %></div>
  <div class="grid grid-cols-2 gap-4">
    <div><%= f.label :status, class: label %><%= f.select :status, Project.statuses.keys.map { |s| [ s.humanize, s ] }, {}, class: field %></div>
    <div><%= f.label :priority, class: label %><%= f.number_field :priority, class: field %></div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :visibility, class: label %>
      <%= f.select :visibility, [ [ "Private", "private" ], [ "Shared with the club", "club" ] ], {}, class: field %>
    </div>
    <div>
      <%= f.label :completion_basis, "Complete when", class: label %>
      <%= f.select :completion_basis, [ [ "Frames are acquired", "acquired" ], [ "Frames are integrated into masters", "integrated" ] ], {}, class: field %>
    </div>
  </div>
  <%= f.submit "Save", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
<% end %>
