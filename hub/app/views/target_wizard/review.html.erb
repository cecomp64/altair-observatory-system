<% content_for :title, "New target — review" %>

<div class="max-w-xl mx-auto">
  <%= render "steps", current_step: "review" %>

  <h1 class="text-xl font-semibold">Review &amp; submit</h1>
  <p class="text-slate-500 text-sm mt-1 mb-6">Double-check everything below, then submit — it'll be picked up the next time <%= @telescope.name %> opens up.</p>

  <div class="rounded-xl border border-slate-200 bg-white p-5 space-y-4">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400">Telescope</p>
      <p class="font-medium"><%= @telescope.name %></p>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-400">Target</p>
        <p class="font-medium"><%= @state["name"] %></p>
      </div>
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-400">Coordinates</p>
        <p class="font-medium">RA <%= number_with_precision(@state["ra_deg"], precision: 3) %>&deg; &middot; Dec <%= number_with_precision(@state["dec_deg"], precision: 3) %>&deg;</p>
      </div>
    </div>
    <% if @state["notes"].present? %>
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-400">Notes</p>
        <p class="text-sm text-slate-700"><%= @state["notes"] %></p>
      </div>
    <% end %>
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-400 mb-2">Exposure plan</p>
      <ul class="divide-y divide-slate-100 text-sm">
        <% (@state["exposure_plans"] || []).each do |plan| %>
          <li class="py-2 flex justify-between">
            <span><%= plan["filter"] %> &middot; <%= plan["exposure_seconds"] %>s</span>
            <span class="text-slate-500">x<%= plan["desired_count"] %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <%= form_with url: target_wizard_review_path, method: :post, class: "pt-6 flex justify-between" do %>
    <%= link_to "Back", target_wizard_exposures_path, class: "rounded-lg px-5 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
    <%= submit_tag "Submit target", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% end %>
</div>
