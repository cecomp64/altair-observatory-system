<% content_for :title, "New target — exposures" %>

<div class="max-w-xl mx-auto">
  <%= render "steps", current_step: "exposures" %>

  <h1 class="text-xl font-semibold">Plan your exposures</h1>
  <p class="text-slate-500 text-sm mt-1 mb-6">Add one row per filter. You can mix filters, exposure lengths, and frame counts.</p>

  <% if @exposure_plans.any? %>
    <ul class="space-y-2 mb-6">
      <% @exposure_plans.each_with_index do |plan, index| %>
        <li class="flex items-center justify-between rounded-lg border border-slate-200 bg-white px-4 py-3">
          <span class="text-sm">
            <span class="font-medium"><%= plan["filter"] %></span>
            &middot; <%= plan["exposure_seconds"] %>s &middot; x<%= plan["desired_count"] %>
            <span class="text-slate-400">(<%= plan["exposure_seconds"].to_i * plan["desired_count"].to_i / 60.0 %> min total)</span>
          </span>
          <%= button_to "Remove", target_wizard_remove_exposure_plan_path(index: index), method: :delete,
                class: "text-xs text-rose-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-400 mb-6">No exposure plans added yet.</p>
  <% end %>

  <%= form_with url: target_wizard_add_exposure_plan_path, method: :post, class: "rounded-xl border border-dashed border-slate-300 p-4 grid grid-cols-4 gap-3 items-end" do %>
    <div class="col-span-1">
      <label class="block text-xs font-medium text-slate-700 mb-1">Filter</label>
      <input type="text" name="filter" placeholder="Luminance" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
    </div>
    <div class="col-span-1">
      <label class="block text-xs font-medium text-slate-700 mb-1">Seconds</label>
      <input type="number" name="exposure_seconds" min="1" placeholder="300" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
    </div>
    <div class="col-span-1">
      <label class="block text-xs font-medium text-slate-700 mb-1">Count</label>
      <input type="number" name="desired_count" min="1" placeholder="20" class="w-full rounded-lg border border-slate-300 px-2 py-1.5 text-sm">
    </div>
    <div class="col-span-1">
      <%= submit_tag "Add", class: "w-full rounded-lg bg-slate-800 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 cursor-pointer" %>
    </div>
  <% end %>

  <%= form_with url: target_wizard_exposures_path, method: :patch, class: "pt-6 flex justify-between" do %>
    <%= link_to "Back", target_wizard_details_path, class: "rounded-lg px-5 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
    <%= submit_tag "Continue", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% end %>
</div>
