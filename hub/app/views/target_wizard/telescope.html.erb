<% content_for :title, "New target — pick a telescope" %>

<div class="max-w-xl mx-auto">
  <%= render "steps", current_step: "telescope" %>

  <h1 class="text-xl font-semibold">Which telescope would you like to use?</h1>
  <p class="text-slate-500 text-sm mt-1 mb-6">Each telescope has its own horizon and imaging schedule. You can review each one's horizon profile before deciding.</p>

  <%= form_with url: new_target_path, method: :patch, class: "space-y-3" do |f| %>
    <% @telescopes.each do |telescope| %>
      <label class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 cursor-pointer hover:border-indigo-300 has-[:checked]:border-indigo-500 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500">
        <%= f.radio_button :telescope_id, telescope.id, checked: @state["telescope_id"] == telescope.id, class: "h-4 w-4 text-indigo-600" %>
        <div>
          <p class="font-medium"><%= telescope.name %></p>
          <p class="text-xs text-slate-500"><%= telescope.description.presence || "#{telescope.latitude}, #{telescope.longitude}" %></p>
        </div>
      </label>
    <% end %>

    <% if @telescopes.empty? %>
      <p class="text-sm text-slate-400">No telescopes are available right now — check back soon.</p>
    <% end %>

    <div class="pt-4 flex justify-end">
      <%= f.submit "Continue", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    </div>
  <% end %>
</div>
