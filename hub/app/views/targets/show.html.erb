<% content_for :title, @target.name %>

<%= link_to "← #{@target.project.name}", project_path(@target.project), class: "text-sm text-slate-500 hover:text-slate-700" %>

<div class="mt-3 flex items-start justify-between">
  <div>
    <h1 class="text-2xl font-semibold"><%= @target.name %> <span class="text-sm font-mono text-slate-400"><%= @target.nina_name %></span></h1>
    <p class="text-slate-500 text-sm mt-1">
      <%= @target.telescope.name %> &middot; <%= @target.effective_optical_train&.name %> &middot;
      RA <%= number_with_precision(@target.ra_deg, precision: 3) %>&deg; &middot;
      Dec <%= number_with_precision(@target.dec_deg, precision: 3) %>&deg;
    </p>
  </div>
  <div class="flex items-center gap-2">
    <span class="rounded-full px-3 py-1 text-xs font-medium
      <%= @target.completed? ? "bg-emerald-100 text-emerald-700" : "bg-indigo-100 text-indigo-700" %>">
      <%= @target.status.humanize %>
    </span>
    <% if policy(@target).cancel? && !@target.cancelled? && !@target.completed? %>
      <%= button_to "Cancel", cancel_target_path(@target), method: :post, data: { turbo_confirm: "Cancel this target?" },
            class: "rounded-lg border border-rose-200 text-rose-600 px-3 py-1.5 text-xs font-medium hover:bg-rose-50" %>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5 md:col-span-1">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Preview</h2>
    <% if @preview %>
      <%= image_tag @preview.url, class: "rounded-lg w-full object-cover aspect-square" %>
    <% else %>
      <div class="rounded-lg bg-slate-100 aspect-square flex items-center justify-center text-slate-400 text-sm">
        No preview yet
      </div>
    <% end %>
    <% if @target.notes.present? %>
      <p class="text-sm text-slate-600 mt-4"><%= @target.notes %></p>
    <% end %>
  </div>

  <div class="md:col-span-2 rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Exposure progress</h2>
    <div class="h-56">
      <%= chart_tag type: "bar", data: {
            labels: @exposure_plans.map(&:filter),
            datasets: [
              { label: "Captured", data: @exposure_plans.map(&:completed_count), backgroundColor: "#6366f1" },
              { label: "Remaining", data: @exposure_plans.map { |ep| [ ep.desired_count - ep.completed_count, 0 ].max }, backgroundColor: "#e2e8f0" }
            ]
          }, options: { scales: { x: { stacked: true }, y: { stacked: true, beginAtZero: true } } } %>
    </div>

    <ul class="mt-4 divide-y divide-slate-100 text-sm">
      <% @exposure_plans.each do |plan| %>
        <li class="py-2 flex items-center justify-between">
          <span><%= plan.filter %> &middot; <%= plan.exposure_seconds %>s</span>
          <span class="text-slate-500"><%= plan.completed_count %> / <%= plan.desired_count %> (<%= plan.percent_complete %>%)</span>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Files</h2>
    <% if @files.any? %>
      <ul class="divide-y divide-slate-100 text-sm">
        <% @files.each do |file| %>
          <li class="py-2 flex items-center justify-between">
            <span>
              <span class="inline-block rounded bg-slate-100 px-2 py-0.5 text-xs font-medium mr-2"><%= file.kind.humanize %></span>
              <%= file.filter if file.filter.present? %>
              <% if file.captured_at %><span class="text-slate-400"><%= file.captured_at.strftime("%b %-d, %Y") %></span><% end %>
            </span>
            <%= link_to "Download", file.url, class: "text-indigo-600 hover:underline", target: "_blank", rel: "noopener" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-400">No files have been published yet.</p>
    <% end %>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Activity</h2>
    <% if @events.any? %>
      <ul class="divide-y divide-slate-100 text-sm">
        <% @events.each do |event| %>
          <li class="py-2 flex items-center justify-between">
            <span><%= event.summary %></span>
            <span class="text-slate-400"><%= time_ago_in_words(event.created_at) %> ago</span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-400">No activity yet.</p>
    <% end %>
  </div>
</div>
