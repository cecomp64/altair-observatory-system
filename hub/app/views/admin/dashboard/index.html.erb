<% content_for :title, "Admin" %>

<h1 class="text-2xl font-semibold mb-2">Admin</h1>
<div class="flex flex-wrap gap-3 text-sm mb-6">
  <%= link_to "Telescopes", admin_telescopes_path, class: "text-indigo-600 hover:underline" %>
  <%= link_to "Processing nodes", admin_processing_nodes_path, class: "text-indigo-600 hover:underline" %>
  <%= link_to "Catalogue", admin_catalogue_path, class: "text-indigo-600 hover:underline" %>
  <%= link_to "Issues (#{@open_issues})", issues_path, class: "text-indigo-600 hover:underline" %>
  <%= link_to "Unassigned frames (#{@unassigned})", unassigned_frames_path, class: "text-indigo-600 hover:underline" %>
</div>

<%= render "dashboard/node_health", nodes: @nodes %>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-medium text-slate-500">Telescopes</h2>
      <%= link_to "Manage", admin_telescopes_path, class: "text-sm text-indigo-600 hover:underline" %>
    </div>
    <ul class="text-sm space-y-1">
      <% @telescopes.each do |t| %>
        <li class="flex justify-between">
          <%= link_to t.name, admin_telescope_path(t), class: "hover:text-indigo-600" %>
          <span class="text-slate-400"><%= t.active? ? "active" : "inactive" %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Targets by status</h2>
    <ul class="text-sm space-y-1">
      <% @targets_by_status.each do |status, count| %>
        <li class="flex justify-between"><span><%= status.humanize %></span><span class="text-slate-500"><%= count %></span></li>
      <% end %>
    </ul>
  </div>
</div>

<div class="rounded-xl border border-slate-200 bg-white p-5">
  <h2 class="text-sm font-medium text-slate-500 mb-3">Recent targets</h2>
  <ul class="divide-y divide-slate-100 text-sm">
    <% @recent_targets.each do |target| %>
      <li class="py-2 flex justify-between">
        <span><%= target.name %> &middot; <span class="text-slate-500"><%= target.telescope.name %></span></span>
        <span class="text-slate-400"><%= target.user.display_name %> &middot; <%= target.status.humanize %></span>
      </li>
    <% end %>
  </ul>
</div>
