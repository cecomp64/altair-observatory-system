<% content_for :title, "Processing nodes" %>
<%= link_to "← Admin", admin_root_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
<div class="mt-3 flex items-center justify-between">
  <h1 class="text-2xl font-semibold">Processing nodes</h1>
  <%= link_to "New node", new_admin_processing_node_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>
<p class="text-sm text-slate-500 mb-4">Each Altair installation (processing PC), and the telescopes it serves.</p>
<div class="rounded-xl border border-slate-200 bg-white p-5">
  <table class="w-full text-sm">
    <thead class="text-left text-slate-400"><tr><th class="pb-2">Node</th><th class="pb-2">Telescopes</th><th class="pb-2">Heartbeat</th><th class="pb-2">Outbox</th><th class="pb-2">NAS free</th></tr></thead>
    <tbody class="divide-y divide-slate-100">
      <% @nodes.each do |node| %>
        <% status = node.status["status"] || {} %>
        <tr>
          <td class="py-2"><%= link_to node.name, admin_processing_node_path(node), class: "font-medium hover:text-indigo-600" %><%= " (inactive)" unless node.active? %></td>
          <td class="py-2 text-slate-600"><%= node.telescopes.map(&:name).join(", ") %></td>
          <td class="py-2 <%= node.healthy? ? "text-emerald-700" : "text-rose-600" %>"><%= node.last_heartbeat_at ? "#{time_ago_in_words(node.last_heartbeat_at)} ago" : "never" %></td>
          <td class="py-2 text-slate-600"><%= status["outbox_depth"] || "—" %></td>
          <td class="py-2 text-slate-600"><%= status["nas_free_pct"] ? "#{status['nas_free_pct']}%" : "—" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @nodes.empty? %><p class="text-sm text-slate-400 mt-2">No processing nodes yet.</p><% end %>
</div>
