<%= form_with model: [ :admin, node ], class: "max-w-xl space-y-5" do |f| %>
  <% if node.errors.any? %><div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3 text-sm text-rose-700"><%= node.errors.full_messages.to_sentence %></div><% end %>
  <div><%= f.label :name, "Name (= hub.node in altair.yaml)", class: "block text-sm font-medium text-slate-700 mb-1" %><%= f.text_field :name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm", placeholder: "altair-proc-01" %></div>
  <div><%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %><%= f.text_area :description, rows: 2, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %></div>
  <div>
    <p class="block text-sm font-medium text-slate-700 mb-1">Telescopes it serves</p>
    <%= f.collection_check_boxes :telescope_ids, Telescope.order(:name), :id, :name do |b| %>
      <label class="flex items-center gap-2 text-sm"><%= b.check_box class: "h-4 w-4" %> <%= b.text %></label>
    <% end %>
  </div>
  <label class="flex items-center gap-2 text-sm"><%= f.check_box :active, class: "h-4 w-4" %> Active</label>
  <%= f.submit class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
<% end %>
