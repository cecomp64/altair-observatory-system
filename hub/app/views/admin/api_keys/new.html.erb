<% content_for :title, "New API key" %>

<h1 class="text-2xl font-semibold mb-6">New API key for <%= @telescope.name %></h1>

<%= form_with url: admin_telescope_api_keys_path(@telescope), class: "max-w-md space-y-5" do %>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Name</label>
    <p class="text-xs text-slate-400 mb-1">e.g. "Observatory PC worker" — helps you tell keys apart later.</p>
    <input type="text" name="api_key[name]" value="<%= @api_key.name %>" required
           class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm">
  </div>
  <%= submit_tag "Generate key", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
<% end %>
