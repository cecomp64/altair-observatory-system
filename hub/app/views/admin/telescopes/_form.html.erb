<%= form_with model: [ :admin, telescope ], class: "space-y-5" do |f| %>
  <% if telescope.errors.any? %>
    <div class="rounded-lg bg-rose-50 border border-rose-200 px-4 py-3 text-sm text-rose-700">
      <%= telescope.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :name, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :slug, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_field :slug, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm", placeholder: "auto-generated from name if left blank" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :latitude, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :latitude, value: CoordinateFormatter.latitude(f.object.latitude), placeholder: "37° 18′ 00″ N or 37.3",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :longitude, class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :longitude, value: CoordinateFormatter.longitude(f.object.longitude), placeholder: "121° 54′ 00″ W or -121.9",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :elevation_m, "Elevation (m)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :elevation_m, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :timezone, "Timezone (IANA)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :timezone, ActiveSupport::TimeZone.all.map(&:tzinfo).map(&:name).uniq.sort, {},
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      <p class="text-xs text-slate-400 mt-1">Nights run local noon to noon in this zone. Altair's <code>site.timezone</code> must match.</p>
    </div>
    <div>
      <%= f.label :min_altitude_deg, "Minimum altitude (°)", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.number_field :min_altitude_deg, step: 0.5, min: 0, max: 89, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div>
    <%= f.label :horizon_file, "Horizon file", class: "block text-sm font-medium text-slate-700 mb-1" %>
    <p class="text-xs text-slate-400 mb-1">A text/CSV file of "azimuth,altitude" pairs in degrees (azimuth 0–360, altitude −90–90) giving the minimum clear altitude at each azimuth. Lines starting with # and a header row are skipped; up to 1 MB.</p>
    <%= f.file_field :horizon_file, class: "w-full text-sm" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :operating_status, "Operating status", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.select :operating_status, Telescope::OPERATING_STATUSES.map { |s| [ s.humanize, s ] }, {},
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
    <div class="col-span-2">
      <%= f.label :status_note, "Note for members", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= f.text_field :status_note, placeholder: "e.g. Closed for mirror cleaning until Friday",
            class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
    </div>
  </div>
  <p class="text-xs text-slate-500 -mt-3">Shown on the Observatory page. Maintenance and offline override what the rig reports.</p>

  <div class="flex items-center gap-6">
    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :active, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %> Active
    </label>
    <label class="flex items-center gap-2 text-sm">
      <%= f.check_box :self_serve_submit, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %> Members can submit directly
    </label>
    <%# Without SJAA members can't link a membership, so the option is offered only
        when SJAA is set up (or to clear a requirement set while it was). %>
    <% if Sjaa::Client.configured? || telescope.requires_sjaa_membership_in_database %>
      <label class="flex items-center gap-2 text-sm">
        <%= f.check_box :requires_sjaa_membership, class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %> Requires an active SJAA membership
      </label>
    <% end %>
  </div>
  <% if Sjaa::Client.configured? %>
    <p class="text-xs text-slate-500 -mt-3">When required, members must link a current SJAA membership to submit to this telescope or resume work on it.</p>
  <% elsif telescope.requires_sjaa_membership_in_database %>
    <p class="text-xs text-rose-600 -mt-3">SJAA isn't set up on this Hub, so members can't link a membership and can't use this telescope. Untick this, or set up SJAA.</p>
  <% end %>

  <div class="pt-2">
    <%= f.submit class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
