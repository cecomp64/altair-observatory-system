<% content_for :title, @telescope.name %>

<%= link_to "← All telescopes", admin_telescopes_path, class: "text-sm text-slate-500 hover:text-slate-700" %>

<div class="mt-3 flex items-center justify-between">
  <h1 class="text-2xl font-semibold"><%= @telescope.name %></h1>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_telescope_path(@telescope), class: "rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium hover:bg-slate-100" %>
    <%= button_to "Delete", admin_telescope_path(@telescope), method: :delete, data: { turbo_confirm: "Delete this telescope? This cannot be undone." },
          class: "rounded-lg border border-rose-200 text-rose-600 px-4 py-2 text-sm font-medium hover:bg-rose-50" %>
  </div>
</div>

<% if flash[:new_api_key_token] %>
  <div class="mt-4 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
    <p class="font-medium mb-1">New API key token (copy it now — it won't be shown again):</p>
    <code class="block bg-white border border-amber-200 rounded px-3 py-2 break-all"><%= flash[:new_api_key_token] %></code>
  </div>
<% end %>

<dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6 text-sm">
  <div><dt class="text-slate-400">Latitude</dt><dd><%= @telescope.latitude %></dd></div>
  <div><dt class="text-slate-400">Longitude</dt><dd><%= @telescope.longitude %></dd></div>
  <div><dt class="text-slate-400">Elevation</dt><dd><%= @telescope.elevation_m || "—" %> m</dd></div>
  <div><dt class="text-slate-400">Status</dt><dd><%= @telescope.active? ? "Active" : "Inactive" %></dd></div>
  <div><dt class="text-slate-400">Timezone</dt><dd><%= @telescope.timezone %></dd></div>
  <div><dt class="text-slate-400">Min altitude</dt><dd><%= @telescope.min_altitude_deg %>°</dd></div>
</dl>

<div class="rounded-xl border border-slate-200 bg-white p-5 mt-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-sm font-medium text-slate-500">Optical trains <span class="text-slate-400">(one per Altair rig; key = rig name)</span></h2>
    <%= link_to "New optical train", new_admin_telescope_optical_train_path(@telescope), class: "text-sm text-indigo-600 hover:underline" %>
  </div>
  <table class="w-full text-sm">
    <thead class="text-left text-slate-400">
      <tr><th class="pb-2">Key</th><th class="pb-2">Name</th><th class="pb-2">Camera</th><th class="pb-2">Focal length</th><th class="pb-2">Filters</th><th></th></tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @optical_trains.each do |train| %>
        <tr>
          <td class="py-2 font-mono text-xs"><%= train.key %><%= " (default)" if train.id == @telescope.default_optical_train_id %></td>
          <td class="py-2"><%= train.name %></td>
          <td class="py-2 text-slate-500"><%= [ train.camera_name, train.camera_type ].compact_blank.join(" · ") %></td>
          <td class="py-2 text-slate-500"><%= train.focal_length_mm ? "#{train.focal_length_mm.to_f} mm" : "—" %></td>
          <td class="py-2 text-slate-500"><%= train.filter_names.join(", ").presence || "—" %>
            <% unless train.complete_optics? %><span class="block text-xs text-amber-600">No optics yet: not sent to Altair</span><% end %></td>
          <td class="py-2 text-right"><%= link_to "Edit", edit_admin_telescope_optical_train_path(@telescope, train), class: "text-xs text-indigo-600 hover:underline" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div class="rounded-xl border border-slate-200 bg-white p-5 mt-6">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-sm font-medium text-slate-500">API keys</h2>
    <%= link_to "New API key", new_admin_telescope_api_key_path(@telescope), class: "text-sm text-indigo-600 hover:underline" %>
  </div>
  <% if @api_keys.any? %>
    <table class="w-full text-sm">
      <thead class="text-left text-slate-400">
        <tr><th class="pb-2">Name</th><th class="pb-2">Last used</th><th class="pb-2">Status</th><th></th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @api_keys.each do |key| %>
          <tr>
            <td class="py-2"><%= key.name %></td>
            <td class="py-2 text-slate-500"><%= key.last_used_at ? time_ago_in_words(key.last_used_at) + " ago" : "never" %></td>
            <td class="py-2"><%= key.active? ? "Active" : "Revoked" %></td>
            <td class="py-2 text-right">
              <%= button_to "Revoke", admin_telescope_api_key_path(@telescope, key), method: :delete,
                    data: { turbo_confirm: "Revoke this API key? Any worker using it will stop working." },
                    class: "text-xs text-rose-600 hover:underline bg-transparent border-0 p-0 cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-slate-400">No API keys yet — the worker needs one to sync targets for this telescope.</p>
  <% end %>
</div>
