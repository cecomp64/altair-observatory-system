<% content_for :title, "New project — telescope" %>
<%# Coming from a telescope's page (?telescope=slug), its default train is preselected. %>
<% preselected = @state["optical_train_id"] || @telescopes.find { |t| t.slug == params[:telescope] }&.default_optical_train_id %>

<div class="max-w-2xl mx-auto">
  <%= render "steps", current_step: "telescope" %>

  <h1 class="text-xl font-semibold">Which telescope would you like to use?</h1>
  <p class="text-slate-500 text-sm mt-1 mb-6">Each telescope has its own horizon and imaging schedule, and each camera setup (optical train) its own field of view and filters. Next you'll see how your objects clear the horizon tonight.</p>

  <%= form_with url: new_project_path, method: :patch, class: "space-y-4" do |f| %>
    <% @telescopes.each do |telescope| %>
      <% trains = telescope.optical_trains.select(&:active?).sort_by(&:key) %>
      <% usable = policy(telescope).use? %>
      <div class="rounded-xl border border-slate-200 bg-white p-4">
        <p class="font-medium"><%= link_to telescope.name, telescope_path(telescope), class: "hover:text-indigo-600", target: "_blank" %>
          <% if telescope.requires_sjaa_membership? %><span class="ml-2 rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-medium text-indigo-700">SJAA members</span><% end %></p>
        <p class="text-xs text-slate-500 mb-3"><%= telescope.description.presence || format_site(telescope) %> · <%= telescope_clock(telescope) %> local</p>
        <div class="mb-3"><%= horizon_silhouette(telescope) %></div>
        <% unless usable %>
          <p class="mb-3 rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800">
            This telescope is for SJAA members with a current membership.
            <% if current_user.sjaa_linked? %>
              Your linked membership isn't current: renew it, then refresh it on <%= link_to "your profile", edit_profile_path, class: "underline" %>.
            <% else %>
              <%= link_to "Link your SJAA membership", edit_profile_path, class: "underline" %> to use it.
            <% end %>
          </p>
        <% end %>
        <div class="space-y-2">
          <% trains.each do |train| %>
            <label class="flex items-center gap-3 rounded-lg border border-slate-200 p-3 <%= usable ? "cursor-pointer hover:border-indigo-300" : "opacity-50 cursor-not-allowed" %> has-[:checked]:border-indigo-500 has-[:checked]:ring-1 has-[:checked]:ring-indigo-500">
              <%= radio_button_tag :optical_train_id, train.id, usable && preselected == train.id, disabled: !usable, class: "h-4 w-4 text-indigo-600" %>
              <div class="text-sm">
                <p class="font-medium"><%= train.name %></p>
                <p class="text-xs text-slate-500">
                  <%= [ train.camera_name, train.camera_type&.upcase ].compact_blank.join(" · ") %>
                  <% if (fov = train.fov_deg) %>· FOV <%= (fov[0] * 60).round %>′ × <%= (fov[1] * 60).round %>′<% end %>
                  <% if train.filter_names.any? %>· <%= train.filter_names.join(", ") %><% end %>
                </p>
              </div>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @telescopes.empty? %>
      <p class="text-sm text-slate-400">No telescopes are available right now — check back soon.</p>
    <% end %>

    <div class="pt-2 flex justify-end">
      <%= f.submit "Continue", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    </div>
  <% end %>
</div>
