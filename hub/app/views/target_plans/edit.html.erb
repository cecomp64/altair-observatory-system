<% content_for :title, "Exposure plans — #{@target.name}" %>
<% field = "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
<% label = "block text-xs uppercase tracking-wide text-slate-400 mb-1" %>

<%= link_to "← #{@target.name}", target_path(@target), class: "text-sm text-slate-500 hover:text-slate-700" %>
<h1 class="text-2xl font-semibold mt-3">Exposure plans</h1>
<p class="text-slate-500 text-sm mt-1 mb-6">
  Ask for more frames, add a filter, or drop a plan nothing was captured for.
  <%= @target.telescope.name %> picks up the change at its next sync<%= "; a completed target reopens when it needs more frames" if @target.completed? %>.
</p>

<%= form_with url: target_plans_path(@target), method: :patch, scope: :target, class: "max-w-2xl space-y-6" do |f| %>
  <div class="rounded-xl border border-slate-200 bg-white">
    <table class="w-full text-sm">
      <thead class="text-left text-xs uppercase tracking-wide text-slate-400">
        <tr><th class="px-4 py-2">Filter</th><th class="px-4 py-2">Exposure</th><th class="px-4 py-2">Captured</th><th class="px-4 py-2">Wanted</th><th class="px-4 py-2">Remove</th></tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% @plans.each do |plan| %>
          <tr id="<%= dom_id(plan) %>">
            <td class="px-4 py-2 font-medium"><%= plan.filter %></td>
            <td class="px-4 py-2"><%= plan.exposure_seconds %> s</td>
            <td class="px-4 py-2 text-slate-500"><%= plan.completed_count %></td>
            <td class="px-4 py-2 w-28">
              <%= number_field_tag "target[plans][#{plan.id}][desired_count]", plan.desired_count, min: 1, class: field,
                    aria: { label: "Frames wanted for #{plan.filter} #{plan.exposure_seconds}s" } %>
            </td>
            <td class="px-4 py-2">
              <% if plan.removable? %>
                <%= check_box_tag "target[plans][#{plan.id}][remove]", "1", false, aria: { label: "Remove #{plan}" } %>
              <% else %>
                <span class="text-xs text-slate-400" title="Frames were captured for this plan">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="rounded-xl border border-slate-200 bg-white p-4">
    <h2 class="text-sm font-medium text-slate-600 mb-3">Add a plan</h2>
    <div class="grid grid-cols-3 gap-3">
      <div>
        <label class="<%= label %>" for="target_new_plan_filter">Filter</label>
        <% if @train&.filter_names&.any? %>
          <%= select_tag "target[new_plan][filter]", options_for_select([ [ "Choose…", "" ] ] + @train.filter_names), id: "target_new_plan_filter", class: field %>
        <% else %>
          <%= text_field_tag "target[new_plan][filter]", nil, id: "target_new_plan_filter", class: field %>
        <% end %>
      </div>
      <div>
        <label class="<%= label %>" for="target_new_plan_exposure_seconds">Exposure (s)</label>
        <%= number_field_tag "target[new_plan][exposure_seconds]", nil, min: 1, id: "target_new_plan_exposure_seconds", class: field %>
      </div>
      <div>
        <label class="<%= label %>" for="target_new_plan_desired_count">Frames</label>
        <%= number_field_tag "target[new_plan][desired_count]", nil, min: 1, id: "target_new_plan_desired_count", class: field %>
      </div>
    </div>
  </div>

  <div class="flex justify-between">
    <%= link_to "Cancel", target_path(@target), class: "rounded-lg px-5 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
    <%= submit_tag "Save plans", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  </div>
<% end %>
