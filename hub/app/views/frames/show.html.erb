<% content_for :title, @frame.file_name %>

<%= link_to "← Files", frames_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
<h1 class="text-xl font-semibold mt-3 break-all"><%= @frame.file_name %></h1>
<p class="text-sm text-slate-500"><%= @frame.image_type.humanize %> · <%= @frame.telescope.name %> · <%= @frame.optical_train.name %> · night of <%= @frame.night %></p>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Frame</h2>
    <dl class="grid grid-cols-2 gap-2 text-sm">
      <dt class="text-slate-400">Target</dt><dd><%= @frame.target ? link_to(@frame.target.name, target_path(@frame.target), class: "text-indigo-600 hover:underline") : "unassigned" %> <span class="text-xs text-slate-400">(<%= @frame.assignment_source %>)</span></dd>
      <dt class="text-slate-400">OBJECT header</dt><dd class="font-mono text-xs"><%= @frame.object_header %></dd>
      <dt class="text-slate-400">Taken</dt><dd><%= @frame.date_obs.utc.strftime("%Y-%m-%d %H:%M:%S UTC") %></dd>
      <dt class="text-slate-400">Filter · exposure</dt><dd><%= @frame.filter %> · <%= @frame.exposure_s&.to_f %> s</dd>
      <dt class="text-slate-400">Gain · offset · bin</dt><dd><%= [ @frame.gain&.to_f, @frame.offset&.to_f, @frame.binning ].compact.join(" · ") %></dd>
      <dt class="text-slate-400">Sensor</dt><dd><%= @frame.sensor_temp_c ? "#{@frame.sensor_temp_c.to_f} °C" : "—" %></dd>
      <dt class="text-slate-400">Rotator</dt><dd><%= [ @frame.rotator_pos&.to_f, @frame.rotator_units ].compact.join(" ") %></dd>
      <dt class="text-slate-400">Pointing</dt><dd><%= @frame.ra_deg ? "RA #{@frame.ra_deg.to_f.round(4)}° Dec #{@frame.dec_deg.to_f.round(4)}°" : "—" %></dd>
      <dt class="text-slate-400">Field of view</dt><dd><%= @frame.fov_width_deg ? "#{(@frame.fov_width_deg.to_f * 60).round(1)}′ × #{(@frame.fov_height_deg.to_f * 60).round(1)}′" : "—" %></dd>
      <dt class="text-slate-400">Status</dt><dd><%= @frame.status %><%= " — #{@frame.status_reason}" if @frame.status_reason.present? %></dd>
      <dt class="text-slate-400">Quality</dt><dd><%= @frame.quality.map { |k, v| "#{k} #{v}" }.join(" · ").presence || "—" %></dd>
      <dt class="text-slate-400">SHA-256</dt><dd class="font-mono text-xs break-all"><%= @frame.sha256 %></dd>
    </dl>
  </div>
  <div class="space-y-6">
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-medium text-slate-500 mb-3">Storage</h2>
      <dl class="grid grid-cols-2 gap-2 text-sm">
        <dt class="text-slate-400">Where</dt><dd><%= @frame.storage_summary %></dd>
        <dt class="text-slate-400">Logical path</dt><dd class="font-mono text-xs break-all"><%= @frame.logical_path %></dd>
        <dt class="text-slate-400">Verified</dt><dd><%= @frame.storage["verified_at"] || "—" %></dd>
      </dl>
      <p class="text-xs text-slate-400 mt-2">Raw frames aren't downloadable from the Hub; they live on the NAS and in S3.</p>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-medium text-slate-500 mb-3">In the field of view</h2>
      <% if @frame.frame_objects.any? %>
        <ul class="text-sm divide-y divide-slate-100">
          <% @frame.frame_objects.sort_by { |fo| fo.angular_distance_arcmin.to_f }.each do |fo| %>
            <li class="py-1.5 flex justify-between"><%= link_to fo.astro_object.primary_name, object_path(fo.astro_object), class: "hover:text-indigo-600" %>
              <span class="text-xs text-slate-400"><%= fo.association_type == "primary" ? "target · " : "" %><%= fo.angular_distance_arcmin.to_f.round(1) %>′ from centre</span></li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-400"><%= @frame.fov_matched_at ? "No catalogue objects." : "Not matched yet." %></p>
      <% end %>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="text-sm font-medium text-slate-500 mb-3">Processing</h2>
      <% if @used_in.any? %>
        <ul class="text-sm">
          <% @used_in.each do |product| %><li><%= product.kind.humanize %> <%= product.night || "v#{product.version}" %> <%= product.filter %></li><% end %>
        </ul>
      <% else %>
        <p class="text-sm text-slate-400">Not in a master yet.</p>
      <% end %>
    </div>
  </div>
</div>

<details class="rounded-xl border border-slate-200 bg-white p-5 mt-6">
  <summary class="cursor-pointer text-sm font-medium text-slate-500">Headers (<%= @frame.headers.size %>)</summary>
  <table class="mt-3 text-xs font-mono">
    <% @frame.headers.each do |key, value| %><tr><td class="pr-4 text-slate-500 align-top"><%= key %></td><td class="break-all"><%= value.to_s %></td></tr><% end %>
  </table>
</details>
