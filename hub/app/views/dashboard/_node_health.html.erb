<div class="rounded-xl border border-slate-200 bg-white p-5 mb-6">
  <h2 class="text-sm font-medium text-slate-500 mb-3">Processing nodes</h2>
  <% if nodes.any? %>
    <ul class="text-sm divide-y divide-slate-100">
      <% nodes.each do |node| %>
        <% status = node.status["status"] || {} %>
        <li class="py-2 flex flex-wrap justify-between gap-2">
          <span><%= link_to node.name, admin_processing_node_path(node), class: "font-medium hover:text-indigo-600" %>
            <span class="text-xs text-slate-400"><%= node.telescopes.map(&:name).join(", ") %></span></span>
          <span class="text-xs <%= node.healthy? ? "text-emerald-700" : "text-rose-600" %>">
            <%= node.last_heartbeat_at ? "heartbeat #{time_ago_in_words(node.last_heartbeat_at)} ago" : "no heartbeat yet" %>
            <%= " · NAS #{status['nas_free_pct']}% free" if status["nas_free_pct"] %>
            <%= " · S3 backlog #{status['s3_backlog']}" if status["s3_backlog"] %>
            <%= " · outbox #{status['outbox_depth']}" if status["outbox_depth"] %>
          </span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-400">No processing nodes yet. <%= link_to "Add one", new_admin_processing_node_path, class: "text-indigo-600 underline" %>.</p>
  <% end %>
</div>
