<% content_for :title, "Dashboard" %>
<%= turbo_stream_from :processing_issues %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-semibold">Welcome back, <%= current_user.display_name %></h1>
    <p class="text-slate-500 text-sm">Your projects, and what's worth imaging tonight.</p>
  </div>
  <%= link_to "New project", new_project_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>

<% if @imaging_now.any? %>
  <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-3 mb-6 text-sm text-emerald-800">
    Imaging now: <%= safe_join(@imaging_now.map { |t| link_to(t.name, telescope_path(t), class: "font-medium underline") }, ", ") %>
  </div>
<% end %>

<% if @my_issues.any? %>
  <div class="rounded-xl border border-amber-200 bg-white p-5 mb-6">
    <h2 class="text-sm font-medium text-amber-700 mb-2">Needs your attention</h2>
    <%= render "issues/list", issues: @my_issues %>
  </div>
<% end %>

<%= render "dashboard/node_health", nodes: @nodes if @nodes.any? %>

<% @tonight.each do |planner| %>
  <% night = planner.night %>
  <div class="rounded-xl border border-slate-200 bg-white p-5 mb-6">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
      <h2 class="font-medium">Tonight at <%= link_to planner.telescope.name, telescope_path(planner.telescope), class: "hover:text-indigo-600" %></h2>
      <p class="text-xs text-slate-500">
        <% if (dark = night.darkness) %>Dark <%= dark.begin.strftime("%H:%M") %>–<%= dark.end.strftime("%H:%M") %><% else %>No astronomical darkness<% end %>
        · Moon <%= (night.moon_illumination * 100).round %>% lit
      </p>
    </div>
    <% if planner.rows.any? %>
      <ul class="divide-y divide-slate-100">
        <% planner.rows.each do |row| %>
          <li class="py-2 flex items-center justify-between gap-3 text-sm">
            <div class="min-w-0">
              <%= link_to row.target.name, target_path(row.target), class: "font-medium hover:text-indigo-600" %>
              <span class="text-xs text-slate-400"><%= row.target.project.name %></span>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <%= altitude_sparkline(row.result, night) %>
              <span class="w-16 text-right text-xs text-slate-500"><%= row.result.hours_clear_in_darkness.round(1) %> h</span>
              <span class="w-14 text-right text-xs <%= row.score.positive? ? "text-indigo-700 font-medium" : "text-slate-400" %>"><%= row.score.positive? ? "score #{row.score.round}" : "not up" %></span>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-400">You have nothing scheduled here.</p>
    <% end %>
    <% suggestions = planner.suggestions(exclude_object_ids: @my_object_ids) %>
    <% if suggestions.any? %>
      <p class="text-xs uppercase tracking-wide text-slate-400 mt-4 mb-1">Well placed tonight</p>
      <div class="flex flex-wrap gap-2">
        <% suggestions.each do |s| %>
          <%= link_to object_path(s.object, telescope: planner.telescope.slug), class: "rounded-lg border border-slate-200 px-3 py-1.5 text-sm hover:border-indigo-300" do %>
            <span class="font-medium"><%= s.object.primary_name %></span>
            <span class="text-xs text-slate-400"><%= s.entry.hours.round(1) %> h · <%= s.entry.max_altitude.round %>°</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="rounded-xl border border-slate-200 bg-white p-5 mb-6">
  <div class="flex items-center justify-between mb-3">
    <h2 class="text-sm font-medium text-slate-500">My projects</h2>
    <%= link_to "All projects", projects_path, class: "text-sm text-indigo-600 hover:underline" %>
  </div>
  <% if @projects.any? %>
    <ul class="divide-y divide-slate-100">
      <% @projects.each do |project| %>
        <% progress = Progress::Calculator.new(project) %>
        <li class="py-3 flex items-center justify-between">
          <div>
            <%= link_to project.name, project_path(project), class: "font-medium text-slate-900 hover:text-indigo-600" %>
            <p class="text-xs text-slate-500"><%= project.targets.map { |t| t.telescope.name }.uniq.join(", ") %> &middot; <%= project.status.humanize %></p>
          </div>
          <div class="w-40">
            <%= render "projects/progress_bar", percent: progress.overall_percent %>
            <p class="text-xs text-slate-500 text-right mt-1"><%= progress.overall_percent %>%<%= " · next #{progress.recommended_filter}" if progress.recommended_filter %></p>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-400">No projects yet — <%= link_to "start one", new_project_path, class: "text-indigo-600 underline" %>.</p>
  <% end %>
</div>

<div class="rounded-xl border border-slate-200 bg-white p-5">
  <h2 class="text-sm font-medium text-slate-500 mb-3">Recent activity</h2>
  <% if @recent_events.any? %>
    <ul class="divide-y divide-slate-100">
      <% @recent_events.each do |event| %>
        <li class="py-3 flex items-center justify-between text-sm">
          <div>
            <%= link_to event.target.name, target_path(event.target), class: "font-medium text-slate-900 hover:text-indigo-600" %>
            <span class="text-slate-500">&mdash; <%= event.summary %></span>
          </div>
          <span class="text-slate-400"><%= time_ago_in_words(event.created_at) %> ago</span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-400">No activity yet.</p>
  <% end %>
</div>
