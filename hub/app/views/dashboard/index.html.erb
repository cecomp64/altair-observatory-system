<% content_for :title, "Dashboard" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-semibold">Welcome back, <%= current_user.display_name %></h1>
    <p class="text-slate-500 text-sm">Here's how your observing targets are doing.</p>
  </div>
  <%= link_to "New target", new_target_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
  <div class="md:col-span-1 rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Targets by status</h2>
    <% if @status_counts.present? %>
      <div class="h-48">
        <%= chart_tag type: "doughnut", data: {
              labels: @status_counts.keys.map(&:humanize),
              datasets: [ { data: @status_counts.values, backgroundColor: %w[#94a3b8 #6366f1 #0ea5e9 #f59e0b #22c55e #ef4444] } ]
            } %>
      </div>
    <% else %>
      <p class="text-sm text-slate-400">No targets yet — create your first one!</p>
    <% end %>
  </div>

  <div class="md:col-span-2 rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Active targets</h2>
    <% if @active_targets.any? %>
      <ul class="divide-y divide-slate-100">
        <% @active_targets.each do |target| %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <%= link_to target.name, target_path(target), class: "font-medium text-slate-900 hover:text-indigo-600" %>
              <p class="text-xs text-slate-500"><%= target.telescope.name %> &middot; <%= target.status.humanize %></p>
            </div>
            <div class="w-32">
              <div class="h-2 rounded-full bg-slate-100 overflow-hidden">
                <div class="h-2 bg-indigo-500" style="width: <%= target.percent_complete %>%"></div>
              </div>
              <p class="text-xs text-slate-500 text-right mt-1"><%= target.percent_complete %>%</p>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-slate-400">Nothing in progress right now.</p>
    <% end %>
  </div>
</div>

<div class="rounded-xl border border-slate-200 bg-white p-5">
  <h2 class="text-sm font-medium text-slate-500 mb-3">Recent activity</h2>
  <% if @recent_events.any? %>
    <ul class="divide-y divide-slate-100">
      <% @recent_events.each do |event| %>
        <li class="py-3 flex items-center justify-between text-sm">
          <div>
            <%= link_to event.target.name, target_path(event.target), class: "font-medium text-slate-900 hover:text-indigo-600" %>
            <span class="text-slate-500">&mdash; <%= event.summary %></span>
          </div>
          <span class="text-slate-400"><%= time_ago_in_words(event.created_at) %> ago</span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-sm text-slate-400">No activity yet.</p>
  <% end %>
</div>
