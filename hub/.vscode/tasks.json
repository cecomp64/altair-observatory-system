{
  // Tasks for the Hub dev container, which opens hub/ as the workspace folder.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hub: Start dev server",
      "detail": "bin/dev: Rails, esbuild and Tailwind watchers on port 3000",
      "type": "shell",
      "command": "bin/dev",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "Hub: Restart web server",
      "detail": "bin/rails restart: Puma reloads in place (tmp_restart); the esbuild and Tailwind watchers keep running",
      "type": "shell",
      "command": "bin/rails restart",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Hub: Run specs",
      "detail": "bundle exec rspec",
      "type": "shell",
      "command": "bundle exec rspec",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "Hub: Lint and security checks",
      "detail": "rubocop, brakeman, bundler-audit",
      "type": "shell",
      "command": "bin/rubocop && bin/brakeman --no-pager && bin/bundler-audit",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": "test"
    },
    {
      "label": "Hub: Update after pull",
      "detail": "bin/setup --skip-server: new gems and packages, migrations",
      "type": "shell",
      "command": "bin/setup --skip-server",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Hub: Edit development credentials",
      "detail": "bin/rails credentials:edit --environment development: opens in a tab, saved encrypted when the tab is closed (needs config/credentials/development.key)",
      "type": "shell",
      "command": "EDITOR='code --wait' bin/rails credentials:edit --environment development",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Hub: Edit production credentials",
      "detail": "bin/rails credentials:edit --environment production: opens in a tab, saved encrypted when the tab is closed (needs config/credentials/production.key)",
      "type": "shell",
      "command": "EDITOR='code --wait' bin/rails credentials:edit --environment production",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Hub: Deploy to Heroku",
      "detail": "git subtree push --prefix hub heroku main (runs from the repo root)",
      "type": "shell",
      "command": "git subtree push --prefix hub heroku main",
      "options": { "cwd": "${workspaceFolder}/.." },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
