<% content_for :title, @telescope.name %>

<%= link_to "← All telescopes", telescopes_path, class: "text-sm text-slate-500 hover:text-slate-700" %>

<div class="mt-3 flex items-center justify-between">
  <h1 class="text-2xl font-semibold"><%= @telescope.name %></h1>
  <%= link_to "Create a target here", new_target_path, class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
</div>
<p class="text-slate-500 mt-1"><%= @telescope.description %></p>

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
  <div class="rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Site</h2>
    <dl class="text-sm space-y-2">
      <div class="flex justify-between"><dt class="text-slate-500">Latitude</dt><dd><%= @telescope.latitude %>&deg;</dd></div>
      <div class="flex justify-between"><dt class="text-slate-500">Longitude</dt><dd><%= @telescope.longitude %>&deg;</dd></div>
      <% if @telescope.elevation_m.present? %>
        <div class="flex justify-between"><dt class="text-slate-500">Elevation</dt><dd><%= @telescope.elevation_m.to_i %> m</dd></div>
      <% end %>
      <div class="flex justify-between"><dt class="text-slate-500">Self-serve submit</dt><dd><%= @telescope.self_serve_submit? ? "Yes" : "No" %></dd></div>
    </dl>
  </div>

  <div class="md:col-span-2 rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-500 mb-3">Horizon profile</h2>
    <% if @horizon_points.present? %>
      <div class="h-64">
        <%= chart_tag type: "line", data: {
              labels: @horizon_points.map { |az, _| az },
              datasets: [ {
                label: "Minimum altitude (°)",
                data: @horizon_points.map { |_, alt| alt },
                borderColor: "#6366f1",
                backgroundColor: "rgba(99, 102, 241, 0.15)",
                fill: true,
                tension: 0.2,
                pointRadius: 0
              } ]
            }, options: {
              scales: {
                x: { title: { display: true, text: "Azimuth (°)" } },
                y: { title: { display: true, text: "Altitude (°)" }, min: 0, max: 90 }
              }
            } %>
      </div>
      <p class="text-xs text-slate-400 mt-2">Targets below this line are obstructed for this telescope.</p>
    <% else %>
      <p class="text-sm text-slate-400">No horizon file uploaded for this telescope yet.</p>
    <% end %>
  </div>
</div>
