<% content_for :title, "Telescopes" %>

<h1 class="text-2xl font-semibold mb-6">Telescopes</h1>

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
  <% @telescopes.each do |telescope| %>
    <%= link_to telescope_path(telescope), class: "block rounded-xl border border-slate-200 bg-white p-5 hover:border-indigo-300" do %>
      <h2 class="font-medium text-lg"><%= telescope.name %></h2>
      <p class="text-sm text-slate-500 mt-1"><%= telescope.description.presence || "No description yet." %></p>
      <p class="text-xs text-slate-400 mt-3">
        <%= number_with_precision(telescope.latitude, precision: 3) %>, <%= number_with_precision(telescope.longitude, precision: 3) %>
        <% if telescope.elevation_m.present? %> &middot; <%= telescope.elevation_m.to_i %> m <% end %>
      </p>
    <% end %>
  <% end %>
</div>

<% if @telescopes.empty? %>
  <p class="text-slate-400">No telescopes are available yet.</p>
<% end %>
