<% content_for :title, "New target — details" %>

<div class="max-w-xl mx-auto">
  <%= render "steps", current_step: "details" %>

  <h1 class="text-xl font-semibold">Tell us about the target</h1>
  <p class="text-slate-500 text-sm mt-1 mb-6">
    Imaging with <span class="font-medium text-slate-700"><%= @telescope.name %></span>.
    You can enter coordinates as decimal degrees, or in sexagesimal form
    (e.g. RA <code class="bg-slate-100 px-1 rounded">05:35:17</code>, Dec <code class="bg-slate-100 px-1 rounded">-05:23:28</code>).
  </p>

  <%= form_with url: target_wizard_details_path, method: :patch, class: "space-y-5" do %>
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Target name</label>
      <input type="text" name="name" value="<%= @name || @state['name'] %>" placeholder="e.g. M42 — Orion Nebula"
             class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" required>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Right ascension</label>
        <input type="text" name="ra" value="<%= @ra || @state['ra_deg'] %>" placeholder="05:35:17"
               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" required>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Declination</label>
        <input type="text" name="dec" value="<%= @dec || @state['dec_deg'] %>" placeholder="-05:23:28"
               class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500" required>
      </div>
    </div>

    <div>
      <label class="block text-sm font-medium text-slate-700 mb-1">Notes <span class="text-slate-400 font-normal">(optional)</span></label>
      <textarea name="notes" rows="3" placeholder="Anything the imaging team should know?"
                class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-indigo-500"><%= @notes || @state["notes"] %></textarea>
    </div>

    <div class="pt-2 flex justify-between">
      <%= link_to "Back", new_target_path, class: "rounded-lg px-5 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
      <%= submit_tag "Continue", class: "rounded-lg bg-indigo-600 px-5 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
    </div>
  <% end %>
</div>
