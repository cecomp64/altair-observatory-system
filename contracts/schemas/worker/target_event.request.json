{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://observatory.local/contracts/worker/target_event.request.json",
  "title": "TargetEventRequest",
  "description": "POST /api/v1/targets/:id/events (scope events:write). Generic escape hatch.",
  "type": "object",
  "required": ["event_type"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": ["progress", "status_changed", "error", "frames_collected", "night_closed", "master_updated", "issue_opened", "issue_resolved", "session"]
    },
    "payload": { "type": "object" }
  }
}
